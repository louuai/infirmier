# ===== Base de données PostgreSQL =====
DATABASE_URL="postgresql://infirmier:infirmier_password@localhost:5432/infirmier_tunis?schema=public"

# ===== Authentification JWT =====
# Générer une clé forte : openssl rand -base64 48
JWT_SECRET="change-me-please-use-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ===== Application =====
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Commission plateforme (en %) =====
PLATFORM_COMMISSION_RATE="20"

# ===== Paiement (architecture prête pour Flouci / Konnect) =====
# PAYMENT_PROVIDER : "mock" | "flouci" | "konnect"
PAYMENT_PROVIDER="mock"
FLOUCI_APP_TOKEN=""
FLOUCI_APP_SECRET=""
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""

# ===== Logs =====
LOG_LEVEL="info"

# ===== Temps réel (Pusher) =====
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
