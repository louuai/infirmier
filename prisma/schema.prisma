// ============================================================
//  Infirmier Tunis - Schéma Prisma v2
//  Marketplace de soins infirmiers à domicile (workflow type Uber)
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum Role {
  PATIENT
  NURSE
  ADMIN
}

enum NurseVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NurseAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum BookingStatus {
  SEARCHING        // demande diffusée à tous les infirmiers du service (dispatch)
  REQUESTED        // (legacy) demande envoyée à un infirmier précis
  REFUSED          // refusée par l'infirmier
  AWAITING_PAYMENT // (legacy) acceptée → en attente de paiement en ligne
  ACCEPTED         // acceptée par un infirmier — paiement sur place, suivi direct
  PAID             // (legacy) payée en ligne → prête à démarrer
  EN_ROUTE         // infirmier en route (tracking actif)
  ARRIVED          // infirmier arrivé
  IN_PROGRESS      // soin en cours
  COMPLETED        // mission terminée
  CANCELLED        // annulée par le client
  EXPIRED          // sans réponse
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  FLOUCI
  D17
  CARD
  KONNECT
}

enum CommissionStatus {
  PENDING
  SETTLED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum InvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

enum NotificationType {
  REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_REFUSED
  PAYMENT_RECEIVED
  NURSE_EN_ROUTE
  NURSE_ARRIVED
  MISSION_COMPLETED
  REVIEW_RECEIVED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  GENERIC
}

enum DocumentType {
  DIPLOMA
  CIN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ===================== USERS =====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  // null si compte créé via Google
  googleId     String?  @unique
  role         Role     @default(PATIENT)
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile    PatientProfile?
  nurseProfile      NurseProfile?
  bookingsAsPatient Booking[]       @relation("PatientBookings")
  reviewsWritten    Review[]        @relation("ReviewAuthor")
  notifications     Notification[]
  favorites         Favorite[]
  conversations     ConversationParticipant[]
  messagesSent      Message[]                 @relation("MessageSender")

  @@index([role])
  @@map("users")
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     String?
  city        String?
  latitude    Float?
  longitude   Float?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([city])
  @@map("patient_profiles")
}

model NurseProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio               String?
  yearsOfExperience Int     @default(0)

  // Localisation de base + position temps réel
  city                 String?
  address              String?
  latitude             Float?
  longitude            Float?
  interventionRadiusKm Float   @default(15)
  currentLat           Float?
  currentLng           Float?
  lastSeenAt           DateTime?

  availability       NurseAvailability       @default(OFFLINE)
  verificationStatus NurseVerificationStatus @default(PENDING)
  verifiedAt         DateTime?

  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  // Abonnement SaaS (accès à l'app). trialEndsAt = essai gratuit 7 j à la validation.
  subscriptionPlan      String?   // "MONTHLY" | "ANNUAL"
  subscriptionExpiresAt DateTime?
  subscriptionRequested Boolean   @default(false) // demande d'activation en attente côté admin
  trialEndsAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents      NurseDocument[]
  availabilities Availability[]
  services       NurseService[]
  bookings       Booking[]        @relation("NurseBookings")
  reviews        Review[]         @relation("ReviewNurse")
  commissions    Commission[]
  invoices       Invoice[]
  payouts        Payout[]
  liveLocations  LiveLocation[]
  favoritedBy    Favorite[]

  @@index([city])
  @@index([verificationStatus])
  @@index([availability])
  @@map("nurse_profiles")
}

model NurseDocument {
  id        String       @id @default(cuid())
  nurseId   String
  nurse     NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  type      DocumentType
  fileUrl   String
  verified  Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([nurseId])
  @@map("nurse_documents")
}

model Availability {
  id        String       @id @default(cuid())
  nurseId   String
  nurse     NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String
  endTime   String

  @@unique([nurseId, dayOfWeek, startTime])
  @@index([nurseId])
  @@map("availabilities")
}

// ===================== SERVICES (tarifs gérés par l'admin) =====================

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique // ex: "injections"
  name        String
  description String?
  price       Float    // tarif fixé par l'admin (TND)
  active      Boolean  @default(true)
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nurses   NurseService[]
  bookings Booking[]

  @@map("services")
}

model NurseService {
  id        String       @id @default(cuid())
  nurseId   String
  nurse     NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([nurseId, serviceId])
  @@index([serviceId])
  @@map("nurse_services")
}

// ===================== BOOKINGS =====================

model Booking {
  id String @id @default(cuid())

  // Patient connecté (optionnel : la demande peut être créée en invité)
  patientId String?
  patient   User?  @relation("PatientBookings", fields: [patientId], references: [id])

  // Coordonnées invité (avant connexion)
  guestName  String?
  guestPhone String?
  guestEmail String?

  // Infirmier : null tant que la demande est en dispatch (SEARCHING)
  nurseId   String?
  nurse     NurseProfile? @relation("NurseBookings", fields: [nurseId], references: [id])
  serviceId String
  service   Service      @relation(fields: [serviceId], references: [id])

  status      BookingStatus @default(SEARCHING)
  scheduledAt DateTime?
  notes       String?

  // Adresse de la visite
  address   String
  city      String?
  latitude  Float?
  longitude Float?

  // Montants figés (TND)
  price            Float
  commissionRate   Float
  commissionAmount Float
  nurseAmount      Float

  acceptedAt  DateTime?
  paidAt      DateTime?
  enRouteAt   DateTime?
  arrivedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment         Payment?
  invoice         Invoice?
  review          Review?
  commission      Commission?
  revenue         Revenue?
  trackingSession TrackingSession?
  liveLocations   LiveLocation[]
  conversation    Conversation?

  @@index([patientId])
  @@index([nurseId])
  @@index([status])
  @@index([serviceId])
  @@map("bookings")
}

// ===================== PAIEMENTS / FINANCES =====================

model Payment {
  id          String          @id @default(cuid())
  bookingId   String          @unique
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String          @default("TND")
  status      PaymentStatus   @default(PENDING)
  provider    PaymentProvider @default(MOCK)
  providerRef String?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@map("payments")
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  nurseId     String
  nurse       NurseProfile  @relation(fields: [nurseId], references: [id])
  amount      Float
  commission  Float
  nurseAmount Float
  status      InvoiceStatus @default(ISSUED)
  pdfUrl      String?
  issuedAt    DateTime      @default(now())

  @@index([nurseId])
  @@map("invoices")
}

model Commission {
  id             String           @id @default(cuid())
  bookingId      String           @unique
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  nurseId        String
  nurse          NurseProfile     @relation(fields: [nurseId], references: [id])
  rate           Float
  platformAmount Float
  nurseAmount    Float
  status         CommissionStatus @default(PENDING)
  settledAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([nurseId])
  @@index([status])
  @@map("commissions")
}

model Payout {
  id          String       @id @default(cuid())
  nurseId     String
  nurse       NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  amount      Float
  status      PayoutStatus @default(PENDING)
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?

  @@index([nurseId])
  @@index([status])
  @@map("payouts")
}

// Ligne de revenu par mission (pour l'analytics)
model Revenue {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  grossAmount    Float
  platformAmount Float
  nurseAmount    Float
  serviceSlug    String
  city           String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([serviceSlug])
  @@map("revenues")
}

// ===================== TRACKING TEMPS RÉEL =====================

model TrackingSession {
  id         String    @id @default(cuid())
  bookingId  String    @unique
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  nurseId    String
  active     Boolean   @default(true)
  lastLat    Float?
  lastLng    Float?
  lastUpdate DateTime?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  @@index([nurseId])
  @@map("tracking_sessions")
}

model LiveLocation {
  id        String       @id @default(cuid())
  nurseId   String
  nurse     NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  latitude  Float
  longitude Float
  createdAt DateTime     @default(now())

  @@index([nurseId])
  @@index([bookingId])
  @@map("live_locations")
}

// ===================== AVIS / FAVORIS / NOTIFS =====================

model Review {
  id        String       @id @default(cuid())
  bookingId String       @unique
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  nurseId   String
  nurse     NurseProfile @relation("ReviewNurse", fields: [nurseId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime     @default(now())

  @@index([nurseId])
  @@map("reviews")
}

model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nurseId   String
  nurse     NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, nurseId])
  @@map("favorites")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERIC)
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}


// ===================== CHAT / MESSAGERIE =====================

enum ConversationKind {
  ADMIN_NURSE
  CLIENT_NURSE
}

model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind
  bookingId     String?          @unique
  booking       Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  lastMessageAt DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([kind])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}
