// ============================================================
//  Infirmier Tunis - Schéma Prisma
//  Marketplace de soins infirmiers à domicile
// ============================================================

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local ; cibles RHEL pour le runtime Vercel/Lambda
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum Role {
  PATIENT
  NURSE
  ADMIN
}

enum NurseVerificationStatus {
  PENDING   // documents soumis, en attente
  APPROVED  // validé par l'admin
  REJECTED  // refusé
}

enum BookingStatus {
  PENDING_NURSE   // créée, en attente de réponse infirmier
  ACCEPTED        // acceptée par l'infirmier
  REFUSED         // refusée par l'infirmier
  IN_PROGRESS     // visite en cours
  COMPLETED       // visite terminée
  CANCELLED       // annulée par le patient
  EXPIRED         // expirée sans réponse
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  FLOUCI
  KONNECT
}

enum CommissionStatus {
  PENDING    // en attente de versement à l'infirmier
  SETTLED    // versée à l'infirmier
}

enum InvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_ACCEPTED
  BOOKING_REFUSED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  REVIEW_RECEIVED
  GENERIC
}

enum DocumentType {
  DIPLOMA
  CIN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ===================== MODELS =====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PATIENT)
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile PatientProfile?
  nurseProfile   NurseProfile?

  // Réservations passées en tant que patient
  bookingsAsPatient Booking[] @relation("PatientBookings")

  reviewsWritten Review[]       @relation("ReviewAuthor")
  notifications  Notification[]

  @@index([role])
  @@map("users")
}

model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Adresse / géolocalisation
  address   String?
  city      String?
  latitude  Float?
  longitude Float?
  dateOfBirth DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@map("patient_profiles")
}

model NurseProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio          String?
  specialties  String[] // ex: ["Pansement", "Injection", "Prise de sang"]
  yearsOfExperience Int  @default(0)
  pricePerVisit     Float @default(0) // en TND

  // Zone d'intervention / géolocalisation
  city          String?
  address       String?
  latitude      Float?
  longitude     Float?
  interventionRadiusKm Float @default(10)

  // Vérification documents
  verificationStatus NurseVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  isAvailable        Boolean @default(true)

  // Note moyenne (dénormalisée pour perf)
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents       NurseDocument[]
  availabilities  Availability[]
  bookings        Booking[]        @relation("NurseBookings")
  reviews         Review[]         @relation("ReviewNurse")
  commissions     Commission[]
  invoices        Invoice[]

  @@index([city])
  @@index([verificationStatus])
  @@index([isAvailable])
  @@map("nurse_profiles")
}

model NurseDocument {
  id        String       @id @default(cuid())
  nurseId   String
  nurse     NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  type      DocumentType
  fileUrl   String
  verified  Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([nurseId])
  @@map("nurse_documents")
}

model Availability {
  id        String       @id @default(cuid())
  nurseId   String
  nurse     NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String       // "08:00"
  endTime   String       // "17:00"

  @@unique([nurseId, dayOfWeek, startTime])
  @@index([nurseId])
  @@map("availabilities")
}

model Booking {
  id          String        @id @default(cuid())
  patientId   String
  patient     User          @relation("PatientBookings", fields: [patientId], references: [id])
  nurseId     String
  nurse       NurseProfile  @relation("NurseBookings", fields: [nurseId], references: [id])

  status      BookingStatus @default(PENDING_NURSE)
  scheduledAt DateTime
  serviceType String        // ex: "Pansement"
  notes       String?

  // Adresse de la visite (snapshot)
  address     String
  city        String?
  latitude    Float?
  longitude   Float?

  // Montants (TND)
  price       Float
  commissionRate   Float   // % au moment de la réservation
  commissionAmount Float
  nurseAmount      Float

  cancelledAt   DateTime?
  cancelReason  String?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment    Payment?
  invoice    Invoice?
  review     Review?
  commission Commission?

  @@index([patientId])
  @@index([nurseId])
  @@index([status])
  @@index([scheduledAt])
  @@map("bookings")
}

model Payment {
  id        String          @id @default(cuid())
  bookingId String          @unique
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount    Float
  currency  String          @default("TND")
  status    PaymentStatus   @default(PENDING)
  provider  PaymentProvider @default(MOCK)
  providerRef String?       // ID transaction du fournisseur
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

model Commission {
  id            String           @id @default(cuid())
  bookingId     String           @unique
  booking       Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  nurseId       String
  nurse         NurseProfile     @relation(fields: [nurseId], references: [id])

  rate          Float            // % prélevé
  platformAmount Float           // part plateforme (10%)
  nurseAmount   Float            // part infirmier (90%)
  status        CommissionStatus @default(PENDING)
  settledAt     DateTime?

  createdAt DateTime @default(now())

  @@index([nurseId])
  @@index([status])
  @@map("commissions")
}

model Invoice {
  id        String        @id @default(cuid())
  number    String        @unique // ex: INV-2026-000123
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  nurseId   String
  nurse     NurseProfile  @relation(fields: [nurseId], references: [id])

  amount       Float
  commission   Float
  nurseAmount  Float
  status       InvoiceStatus @default(ISSUED)
  issuedAt     DateTime      @default(now())

  @@index([nurseId])
  @@map("invoices")
}

model Review {
  id        String       @id @default(cuid())
  bookingId String       @unique
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  nurseId   String
  nurse     NurseProfile @relation("ReviewNurse", fields: [nurseId], references: [id])

  rating    Int          // 1..5
  comment   String?
  createdAt DateTime     @default(now())

  @@index([nurseId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERIC)
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}
